<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FileEncryptorGUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\GUI-Qt\logogui.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 程序集版本与对外版本一致；同版本覆盖安装由 installer 的
         AllowSameVersionUpgrades="yes" 保证先卸后装。 -->
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <FileVersion>3.2.0.0</FileVersion>
    <Version>3.2.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- NETSDK1206: WindowsAppSDK 携带 win10-* 版本化 RID 资产，.NET 8+ 默认不解析。
         本工程 RuntimeIdentifier 仅 win-x64，资产实际可用；属 SDK 级提示，静音保持输出干净。 -->
    <NoWarn>NETSDK1206</NoWarn>
    <!-- 发布卫生：Release 不产出 portable PDB，避免 IL 字节码/源码绝对路径/局部变量名随 MSI 外泄（B2） -->
    <DebugType Condition=" '$(Configuration)' == 'Release' ">none</DebugType>
    <DebugSymbols Condition=" '$(Configuration)' == 'Release' ">false</DebugSymbols>
    <!-- 注：.NET 程序集的 CFG 由 CLR 侧提供，本工程无原生 .cpp，无需再加 /guard:cf -->
    <!-- 包体压缩（Release publish）：partial 裁剪框架库与 Windows.SDK.NET 投影，
         互操作层经 trimmer_roots.xml 保留。普通 Build 不裁（只 Publish 生效）。 -->
    <PublishTrimmed Condition=" '$(Configuration)' == 'Release' ">true</PublishTrimmed>
    <TrimMode Condition=" '$(Configuration)' == 'Release' ">partial</TrimMode>
    <!-- 只保留英文卫星资源（异常消息等 .NET 资源），业务文案走自实现 L10n 不受影响 -->
    <SatelliteResourceLanguages Condition=" '$(Configuration)' == 'Release' ">en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="trimmer_roots.xml" />
  </ItemGroup>
  <ItemGroup Condition=" '$(Configuration)' == 'Release' ">
    <TrimmerRootDescriptor Include="trimmer_roots.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240802000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1" />
    <!-- P2-1 设备绑定：ProtectedData（DPAPI）在 net8.0-windows 不含于默认引用集 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- 共享资源：引用 GUI-Qt 中的图标，不重复存放 -->
  <ItemGroup>
    <None Include="..\GUI-Qt\logogui.ico" Link="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\shared\pack.json" Link="pack.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\shared\achievements\**\*.json" Link="achievements\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" />
  </ItemGroup>

  <!-- VS 普通构建（$(OutDir)=bin\x64\Release\net8.0-windows10.0.19041.0）后，把加密盘依赖
       二进制复制到输出目录，使从 VS 直接 F5 运行 GUI 即可定位 FE-Mounter / vdisk / CLI。
       这些外部产物不在本工程内，普通生成不带；publish 部署仍由 build_mounter.py 同步到 win-x64\publish。 -->
  <Target Name="CopyVaultDeps" AfterTargets="Build">
    <PropertyGroup>
      <CliOutDir>..\CLI\out\build\windows-release\bin\</CliOutDir>
    </PropertyGroup>
    <!-- CLI 由 wixproj 的 StageCliAfterPublish 构建，时序上晚于本目标。首次全量构建或
         CLI 构建树被清理时这些产物尚不存在，若不判存在会 MSB3030 中断整个生成，
         导致后面真正构建 CLI 的步骤永远没机会执行（死循环）。缺件只告警：
         此处仅为 F5 调试便利，MSI 打包所需的三件套由 StageCliAfterPublish 负责。 -->
    <ItemGroup>
      <VaultDep Include="$(CliOutDir)vdisk.dll" Condition="Exists('$(CliOutDir)vdisk.dll')" />
      <VaultDep Include="$(CliOutDir)Release\FE-Mounter.exe" Condition="Exists('$(CliOutDir)Release\FE-Mounter.exe')" />
      <VaultDep Include="$(CliOutDir)FE-Mounter.exe" Condition="Exists('$(CliOutDir)FE-Mounter.exe')" />
      <VaultDep Include="$(CliOutDir)FileEncryptorCLI-*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(VaultDep)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Warning Text="CopyVaultDeps 跳过：未找到 CLI 产物（$(CliOutDir)）。首次全量构建或 CLI 构建树被清理时属正常，从 VS 直接 F5 会缺 FE-Mounter/vdisk；MSI 打包不受影响，三件套由 StageCliAfterPublish 补齐。"
             Condition="!Exists('$(CliOutDir)vdisk.dll')" />
  </Target>
</Project>
