<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FileEncryptorGUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\GUI-Qt\logogui.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- AssemblyVersion 固定以保持内部 XAML/类型引用稳定；FileVersion/Version 固定 3.0.0.0/3.0.0。
         覆盖安装的文件替换由 installer 的 MajorUpgrade AllowSameVersionUpgrades="yes" 解决（相同
         版本也先卸后装），不依赖版本号递增。 -->
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <Version>3.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 发布卫生：Release 不产出 portable PDB，避免 IL 字节码/源码绝对路径/局部变量名随 MSI 外泄（B2） -->
    <DebugType Condition=" '$(Configuration)' == 'Release' ">none</DebugType>
    <DebugSymbols Condition=" '$(Configuration)' == 'Release' ">false</DebugSymbols>
    <!-- 注：.NET 程序集的 CFG 由 CLR 侧提供，本工程无原生 .cpp，无需再加 /guard:cf -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240802000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1" />
  </ItemGroup>

  <!-- 共享资源：引用 GUI-Qt 中的图标，不重复存放 -->
  <ItemGroup>
    <None Include="..\GUI-Qt\logogui.ico" Link="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" />
  </ItemGroup>

  <!-- VS 普通构建（$(OutDir)=bin\x64\Release\net8.0-windows10.0.19041.0）后，把加密盘依赖
       二进制复制到输出目录，使从 VS 直接 F5 运行 GUI 即可定位 FE-Mounter / vdisk / CLI。
       这些外部产物不在本工程内，普通生成不带；publish 部署仍由 build_mounter.py 同步到 win-x64\publish。 -->
  <Target Name="CopyVaultDeps" AfterTargets="Build">
    <ItemGroup>
      <VaultDep Include="..\CLI\out\build\windows-release\bin\vdisk.dll" />
      <VaultDep Include="..\CLI\out\build\windows-release\bin\Release\FE-Mounter.exe" />
      <VaultDep Include="..\CLI\out\build\windows-release\bin\FileEncryptorCLI-*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(VaultDep)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
