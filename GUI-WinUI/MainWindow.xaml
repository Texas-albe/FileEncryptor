<Window
    x:Class="FileEncryptorGUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:FileEncryptorGUI.Models"
    xmlns:local="using:FileEncryptorGUI"
    Title="FileEncryptorGUI">

    <Grid x:Name="RootGrid" RowDefinitions="*,Auto,Auto">

        <!-- 标签页：Explorer 式标题栏。TabView 自己接管标题栏并预留系统按钮位；
             标签条右侧空白由代码用 SetDragRectangles 精确设为拖拽区，
             这样标签的「×」与内置「+」才能收到点击（WinUI issue #3193）。 -->
        <!-- TabView 默认样式带 VerticalAlignment="Top"，不显式 Stretch 的话
             整个标签控件只占内容高度，页面里的卡片就「上下撑不满」 -->
        <controls:TabView x:Name="MainTabView" Grid.Row="0" VerticalAlignment="Stretch"
                          IsAddTabButtonVisible="True"
                          AddTabButtonClick="OnAddTabButtonClick"
                          TabCloseRequested="OnTabCloseRequested"
                          SelectionChanged="OnTabSelectionChanged">
            <!-- 标签条右侧空白：窗口拖拽区。撑满剩余宽度（右侧留出系统按钮位置），
                 拖拽区再由代码用 SetDragRectangles 精确限定到这里 -->
            <controls:TabView.TabStripFooter>
                <Grid x:Name="TitleBarDragRegion" Background="Transparent"
                      HorizontalAlignment="Stretch" MinWidth="80" Margin="0,0,146,0" />
            </controls:TabView.TabStripFooter>

            <!-- 启动只有主页一个标签：设置 / 加密盘管理由「+」按需新开，
                 终端由执行状态自动开合（见 EnsureTerminalTab / CloseTerminalTab） -->
            <controls:TabViewItem x:Name="TabHome" Header="主页" IsClosable="True">
                <local:HomeTabView x:Name="HomeView" />
            </controls:TabViewItem>

        </controls:TabView>

        <!-- 底部：命令预览。独立表面 + 顶部分割线，与页面内容分开 -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="命令预览" Style="{StaticResource AppCaptionTextStyle}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1" IsReadOnly="True" TextWrapping="NoWrap"
                         Text="{x:Bind ViewModel.CommandPreview, Mode=OneWay}"
                         FontFamily="Consolas" Height="36" Padding="6,4,6,12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                <Button Grid.Column="2" Content="任务历史..." Click="OnOpenTaskHistory"
                        Height="32" Padding="10,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 状态栏：弱化的辅助文字，不抢内容区注意力 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="12,6">
            <TextBlock x:Name="StatusLabel" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource AppSecondaryTextStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="ProgressLabel" Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}"
                       Style="{StaticResource AppCaptionTextStyle}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
