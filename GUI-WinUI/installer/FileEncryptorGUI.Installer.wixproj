<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <!-- 版本固定 3.0.0。覆盖安装的文件替换问题由 Product.wxs 的
         MajorUpgrade AllowSameVersionUpgrades="yes" 解决（相同版本也先卸后装），不靠版本号递增。 -->
    <GuiVersion>3.0.0</GuiVersion>
    <!-- CLI 产物名由 CMake project(VERSION) 拼出，只支持数值版（无 -alpha.N），故独立定义 -->
    <CliVersion>3.0.0</CliVersion>
    <OutputType>Package</OutputType>
    <OutputName>FileEncryptorGUI-$(GuiVersion)-WinUI-Windows</OutputName>
    <Platform>x64</Platform>
    <!-- 发布目录唯一来源：PublishDir 变量与 StageCliAfterPublish 拷贝目标共用，避免路径不一致 -->
    <GuiPublishDir>..\bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\publish</GuiPublishDir>
    <DefineConstants>PublishDir=$(GuiPublishDir);Version=$(GuiVersion);ProductVersion=$(GuiVersion)</DefineConstants>
    <SuppressIces>ICE03</SuppressIces>
    <!-- CLI 构建树（cmake 生成，Release 配置固定） -->
    <CliBuildDir>..\..\CLI\out\build\windows-release</CliBuildDir>
    <!-- FE-Mounter 独立构建树（FE-Mounter/CMakeLists.txt，产物并入 CliBuildDir 的 bin\Release） -->
    <MounterBuildDir>$(MSBuildThisFileDirectory)..\..\CLI\out\build\fe-mounter</MounterBuildDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>

  <!-- 构建 MSI 前自动 publish GUI-WinUI 自包含部署，并复制 .xbf 文件（WinUI3 publish 已知问题） -->
  <Target Name="PublishGuiBeforeBuild" BeforeTargets="BeforeBuild">
    <!-- 先普通 Build 刷新 win-x64 输出（含最新 .xbf）：WinUI3 自包含 Publish 不会把 .xbf 放进
         publish 目录，wixproj 需从 win-x64 普通 Build 输出 Copy；若只 Publish 不 Build，win-x64
         的 .xbf 会停在上次普通 Build，导致 MSI 装入旧 XAML（勾选框/可见性等修复丢失）。 -->
    <MSBuild Projects="..\FileEncryptorGUI.WinUI3.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=x64" />
    <MSBuild Projects="..\FileEncryptorGUI.WinUI3.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);Platform=x64;RuntimeIdentifier=win-x64;SelfContained=true" />
    <Copy SourceFiles="..\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\App.xbf;..\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\MainWindow.xbf;..\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\TaskNotificationWindow.xbf"
          DestinationFolder="..\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\publish" />
    <!-- Updater 由 build_updater.ps1 产出，publish 后补拷，MSI 才能把更新器一并装入 -->
    <Copy SourceFiles="..\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\Updater.exe"
          DestinationFolder="..\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\publish"
          Condition="Exists('..\bin\x64\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\Updater.exe')"
          SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <!-- Ninja+cl 需要 vcvars 注入的 INCLUDE/LIB/PATH 才能编译；VS 内构建时 VSINSTALLDIR 有值，命令行 msbuild 时回退到本机安装路径 -->
    <VcVarsBat Condition="'$(VcVarsBat)'=='' and '$(VSINSTALLDIR)'!=''">$(VSINSTALLDIR)\VC\Auxiliary\Build\vcvars64.bat</VcVarsBat>
    <VcVarsBat Condition="'$(VcVarsBat)'==''">E:\Microsoft Visual Studio\VC\Auxiliary\Build\vcvars64.bat</VcVarsBat>
    <!-- 必须用 VS 内置 cmake：PATH 里 Strawberry 等旧版 cmake 不认识 "Visual Studio 18 2026" 生成器（FE-Mounter 用 VS 生成器配置） -->
    <CMakeExe Condition="'$(CMakeExe)'=='' and '$(VSINSTALLDIR)'!=''">$(VSINSTALLDIR)\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
    <CMakeExe Condition="'$(CMakeExe)'==''">E:\MICROSOFT VISUAL STUDIO\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExe>
    <!-- 构建脚本：复刻 vcvars_env.py 的环境补偿（先 vcvars 设好 MSVC/SDK 环境，再补本机缺失的 SDK um/ucrt 库路径），
         然后跑 cmake build。用独立 .bat 而非 cmd /c 内联，避免 %LIB% 解析期展开冲掉 vcvars 设置的库路径。 -->
    <BuildHelper>$(MSBuildThisFileDirectory)..\..\.workbuddy\build_with_vcvars.bat</BuildHelper>
  </PropertyGroup>

  <!-- CLI 三件套并入 MSI：publish 之后拷贝，确保不被动覆盖；cmake 已配置则先增量编译 -->
  <Target Name="StageCliAfterPublish" AfterTargets="PublishGuiBeforeBuild">
    <Exec Command="&quot;$(BuildHelper)&quot; &quot;$(VcVarsBat)&quot; &quot;$(CMakeExe)&quot; &quot;$(CliBuildDir)&quot; Release"
          Condition="Exists('$(CliBuildDir)\CMakeCache.txt')" />
    <!-- FE-Mounter 已从 CLI 主构建拆出，需单独构建（产物同落 bin\Release） -->
    <Exec Command="&quot;$(BuildHelper)&quot; &quot;$(VcVarsBat)&quot; &quot;$(CMakeExe)&quot; &quot;$(MounterBuildDir)&quot; Release"
          Condition="Exists('$(MounterBuildDir)\CMakeCache.txt')" />
    <!-- 产物目录逐个文件解析：CLI 主构建是 Ninja 单配置，产物直接落 bin\；
         FE-Mounter 走 VS 生成器，产物落 bin\Release\（bin\Release\ 里还留着早期
         多配置时代的陈旧 CLI 副本）。写死一个目录会装进旧 CLI，表现为
         「MSI 里没有/不是最新的 CLI」却没有任何提示。 -->
    <PropertyGroup>
      <CliBinRoot>$(CliBuildDir)\bin\</CliBinRoot>
      <CliBinCfg>$(CliBuildDir)\bin\Release\</CliBinCfg>
      <P_CliExe Condition="Exists('$(CliBinRoot)FileEncryptorCLI-$(CliVersion)-cmd-Windows.exe')">$(CliBinRoot)FileEncryptorCLI-$(CliVersion)-cmd-Windows.exe</P_CliExe>
      <P_CliExe Condition="'$(P_CliExe)'==''">$(CliBinCfg)FileEncryptorCLI-$(CliVersion)-cmd-Windows.exe</P_CliExe>
      <P_Vdisk Condition="Exists('$(CliBinRoot)vdisk.dll')">$(CliBinRoot)vdisk.dll</P_Vdisk>
      <P_Vdisk Condition="'$(P_Vdisk)'==''">$(CliBinCfg)vdisk.dll</P_Vdisk>
      <P_Mounter Condition="Exists('$(CliBinRoot)FE-Mounter.exe')">$(CliBinRoot)FE-Mounter.exe</P_Mounter>
      <P_Mounter Condition="'$(P_Mounter)'==''">$(CliBinCfg)FE-Mounter.exe</P_Mounter>
      <P_Winfsp Condition="Exists('$(CliBinRoot)winfsp-x64.dll')">$(CliBinRoot)winfsp-x64.dll</P_Winfsp>
      <P_Winfsp Condition="'$(P_Winfsp)'==''">$(CliBinCfg)winfsp-x64.dll</P_Winfsp>
      <P_Launcher Condition="Exists('$(CliBinRoot)launcher-x64.exe')">$(CliBinRoot)launcher-x64.exe</P_Launcher>
      <P_Launcher Condition="'$(P_Launcher)'==''">$(CliBinCfg)launcher-x64.exe</P_Launcher>
    </PropertyGroup>
    <Copy SourceFiles="$(P_CliExe)"
          DestinationFiles="$(GuiPublishDir)\FileEncryptorCLI.exe"
          SkipUnchangedFiles="true"
          Condition="Exists('$(P_CliExe)')" />
    <Copy SourceFiles="$(P_Vdisk)"
          DestinationFolder="$(GuiPublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(P_Vdisk)')" />
    <Copy SourceFiles="$(P_Mounter)"
          DestinationFolder="$(GuiPublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(P_Mounter)')" />
    <!-- WinFSP 用户态运行时：FE-Mounter 静态导入 winfsp-x64.dll，缺它进程根本起不来
         （表现为「挂载盘用不了」且没有任何提示）。launcher 是 WinFSP 服务启动器，
         目标机没预装 WinFSP 时由它拉起服务。两者都必须与 FE-Mounter.exe 同目录。 -->
    <Copy SourceFiles="$(P_Winfsp);$(P_Launcher)"
          DestinationFolder="$(GuiPublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(P_Winfsp)')" />
    <!-- 暂存区缺件要显式告警：Copy 的 Exists 条件会静默跳过，最后表现为
         「安装包里没有 CLI / FE-Mounter / WinFSP」，比构建失败更难查。 -->
    <Warning Condition="!Exists('$(P_CliExe)')"
             Text="[installer] 未找到 FileEncryptorCLI-$(CliVersion)-cmd-Windows.exe（已查 bin\ 与 bin\Release\）：安装包将不含 CLI 程序。请先构建 CLI。" />
    <Warning Condition="!Exists('$(P_Vdisk)')"
             Text="[installer] 未找到 vdisk.dll：安装包将不含加密盘库，入盘与挂载都不可用。请先构建 CLI。" />
    <Warning Condition="!Exists('$(P_Mounter)')"
             Text="[installer] 未找到 FE-Mounter.exe：安装包将不含加密盘挂载组件。请先构建 FE-Mounter 工程。" />
    <Warning Condition="!Exists('$(P_Winfsp)')"
             Text="[installer] 未找到 winfsp-x64.dll：安装包将不含 WinFSP 运行时，盘符挂载无法工作。请确认构建 FE-Mounter 时能找到 WinFSP SDK。" />
  </Target>
</Project>
