<UserControl
    x:Class="FileEncryptorGUI.SettingsTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer Margin="16,12,16,12" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">

            <controls:Border Style="{StaticResource AppCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="主题" Style="{StaticResource AppSectionHeaderTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,4,0,0">
                        <RadioButton x:Name="ThemeLightRb" Content="浅色" GroupName="Theme" Checked="OnThemeLight" />
                        <RadioButton x:Name="ThemeDarkRb" Content="深色" GroupName="Theme" Checked="OnThemeDark" />
                        <RadioButton x:Name="ThemeSystemRb" Content="跟随系统" GroupName="Theme" Checked="OnThemeSystem" />
                    </StackPanel>
                </StackPanel>
            </controls:Border>

            <controls:Border Style="{StaticResource AppCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="语言" Style="{StaticResource AppSectionHeaderTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,4,0,0">
                        <RadioButton x:Name="LangZhRb" Content="简体中文" GroupName="Lang" Checked="OnLangZh" />
                        <RadioButton x:Name="LangEnRb" Content="English" GroupName="Lang" Checked="OnLangEn" />
                        <RadioButton x:Name="LangRuRb" Content="Русский" GroupName="Lang" Checked="OnLangRu" />
                    </StackPanel>
                </StackPanel>
            </controls:Border>

            <controls:Border Style="{StaticResource AppCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="背景" Style="{StaticResource AppSectionHeaderTextStyle}" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                        <TextBox x:Name="BgImageEdit" Grid.Column="0" PlaceholderText="背景图片路径（留空使用亚克力效果）" />
                        <Button Grid.Column="1" Content="浏览..." Click="OnBrowseBackground" />
                        <Button Grid.Column="2" Content="清除" Click="OnClearBackground" />
                        <Button Grid.Column="3" Content="应用" Click="OnApplyBackground" Style="{StaticResource AppPrimaryButtonStyle}" />
                    </Grid>
                    <TextBlock Text="支持 PNG / JPG / BMP / WebP 格式。"
                               Style="{StaticResource AppCaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </controls:Border>

            <controls:Border Style="{StaticResource AppCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="程序" Style="{StaticResource AppSectionHeaderTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="重新检测 CLI 程序" Click="OnRetryCliDetection" />
                        <Button Content="编辑 CLI 配置" Click="OnEditConfig" />
                    </StackPanel>
                </StackPanel>
            </controls:Border>

            <controls:Border Style="{StaticResource AppCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于" Style="{StaticResource AppSectionHeaderTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="检查更新..." Click="OnCheckForUpdate" />
                        <Button Content="鸣谢..." Click="OnCredits" />
                        <Button Content="README 摘要..." Click="OnReadme" />
                    </StackPanel>
                </StackPanel>
            </controls:Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
