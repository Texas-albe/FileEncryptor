<UserControl
    x:Class="FileEncryptorGUI.TerminalTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 上：批量进度帧区（每帧替换显示，不堆叠）
         下：日志区（滚动追加，清空走右键菜单） -->
    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 帧区：NoWrap 保列对齐，超高内部滚动 -->
        <ScrollViewer x:Name="FrameScroll" Grid.Row="0"
                      MaxHeight="320"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Visible"
                      HorizontalScrollMode="Auto"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      Padding="16,10"
                      Visibility="Collapsed">
            <RichTextBlock x:Name="FrameOutput" FontFamily="Consolas" FontSize="12.5"
                           LineHeight="18" IsTextSelectionEnabled="True" TextWrapping="NoWrap">
                <Paragraph x:Name="FrameParagraph" />
            </RichTextBlock>
        </ScrollViewer>

        <!-- 日志区 -->
        <ScrollViewer x:Name="TerminalScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      Padding="16,12">
            <!-- 右键菜单在构造函数里建：XAML 里给 MenuFlyoutItem 起 x:Name 会让
                 XamlCompiler 静默崩溃（exit 1、无日志），且菜单不在视觉树上，
                 LocalizeTree 也遍历不到，文案必须按当前语言现写 -->
            <RichTextBlock x:Name="TerminalOutput" FontFamily="Consolas" FontSize="12.5"
                           LineHeight="18" IsTextSelectionEnabled="True" TextWrapping="Wrap">
                <Paragraph x:Name="TerminalParagraph" />
            </RichTextBlock>
        </ScrollViewer>
    </Grid>
</UserControl>
