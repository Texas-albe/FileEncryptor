<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FileEncryptorMobile.PreviewPage"
             xmlns:local="clr-namespace:FileEncryptorMobile"
             Title="{local:Zh 预览}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,12,16,12">

        <VerticalStackLayout Grid.Row="0" Spacing="6" Margin="0,0,0,10">
            <Label x:Name="LblName" Style="{StaticResource DialogTitle}"
                   LineBreakMode="TailTruncation" />
            <Label x:Name="LblMeta" Style="{StaticResource Caption}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource GridGapSm}" Margin="0,4,0,0">
                <Button Grid.Column="0" x:Name="BtnText" Text="{local:Zh 文本}"
                        Style="{StaticResource SegmentSelected}" Clicked="OnTextMode" />
                <Button Grid.Column="1" x:Name="BtnHex" Text="{local:Zh 十六进制}"
                        Style="{StaticResource SegmentUnselected}" Clicked="OnHexMode" />
                <Button Grid.Column="2" x:Name="BtnReload" Text="{local:Zh 重新载入}"
                        Style="{StaticResource SmallSecondaryButton}" Clicked="OnReload" />
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" x:Name="Scroll" Padding="10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
            <Label x:Name="Content" FontFamily="monospace" FontSize="{StaticResource FontSizeCaption}"
                   LineBreakMode="WordWrap" />
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource GridGapSm}" Margin="0,10,0,0">
            <Button Grid.Column="0" x:Name="BtnPrev" Text="{local:Zh 上一页}"
                    Style="{StaticResource SmallSecondaryButton}" Clicked="OnPrev" IsVisible="False" />
            <Label Grid.Column="1" x:Name="LblOffset" Style="{StaticResource Caption}"
                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            <Button Grid.Column="2" x:Name="BtnNext" Text="{local:Zh 下一页}"
                    Style="{StaticResource SmallSecondaryButton}" Clicked="OnNext" IsVisible="False" />
        </Grid>
    </Grid>
</ContentPage>
