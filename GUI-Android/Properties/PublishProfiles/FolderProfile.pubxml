<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<!--
  Android 发布配置注意：
  1) 不要在这里写 <RuntimeIdentifier>（单数）。.NET for Android 的
     Microsoft.Android.Sdk.DefaultProperties.targets 里有
     <RuntimeIdentifier Condition="'$(RuntimeIdentifiers)' != '' And '$(RuntimeIdentifier)' != ''" />
     —— 复数与单数同时非空时，SDK 会故意把单数清空（改用复数推导各 ABI）。
     本项目 csproj 已设 <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>，
     profile 再写单数就会与它冲突。
  2) 不要开 PublishSingleFile：单文件发布是桌面自包含应用的特性，Android 不支持，
     且它要求显式 RID，缺 RID 直接报 NETSDK1191
     （VS 里的现象："无法推断属性 PublishSingleFile 的运行时标识符。显式指定 rid。"）。
  3) RID 只能写复数 <RuntimeIdentifiers>：.NET for Android 的
     Microsoft.Android.Sdk.DefaultProperties.targets 里有
     <RuntimeIdentifier Condition="'$(RuntimeIdentifiers)' != '' And '$(RuntimeIdentifier)' != ''" />，
     复数与单数同时非空时 SDK 会故意把单数清空（改用复数推导各 ABI），
     单数被清空后 PublishSingleFile 之类的按 RID 取值的属性就拿不到 RID → NETSDK1191。
  4) SelfContained 对 Android 本来就恒为 true，保留即可。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>E:\Release\android</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>