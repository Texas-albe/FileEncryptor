<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Media3 绑定改由 Third Party/android-libraries 本地源码构建产出：
       build/media3-bindings/nuget 是本地文件夹源，Media3.* 只从这里取，
       其余包仍走 nuget.org，避免同名同版本的两份包被混淆。 -->
  <packageSources>
    <clear />
    <add key="local-media3" value="../build/media3-bindings/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-media3">
      <package pattern="Xamarin.AndroidX.Media3.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
