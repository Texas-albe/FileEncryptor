<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note -->

    <!-- 主题色与启动图/ -->
    <Color x:Key="Primary">#4A72C8</Color>
    <Color x:Key="PrimaryDark">#6E93DE</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DCE6F8</Color>
    <Color x:Key="SecondaryDarkText">#B9CBEE</Color>
    <Color x:Key="Tertiary">#35558F</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- ===== 语义色板 =====
         页面/组件只引用这里的 Light/Dark 成对键，避免散落的硬编码色值在深色模式下失配。
         命名规则：<语义><Light|Dark>；主色仍复用上方 Primary / PrimaryDark。 -->

    <!-- 画布与表面 -->
    <Color x:Key="CanvasLight">#F6F7F9</Color>
    <Color x:Key="CanvasDark">#16181C</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#222529</Color>
    <Color x:Key="SurfaceMutedLight">#F2F3F5</Color>
    <Color x:Key="SurfaceMutedDark">#1C2026</Color>

    <!-- 描边与分割线 -->
    <Color x:Key="StrokeLight">#DFE3EA</Color>
    <Color x:Key="StrokeDark">#333A44</Color>
    <Color x:Key="DividerLight">#E8EBF0</Color>
    <Color x:Key="DividerDark">#2C333C</Color>

    <!-- 文字三级 -->
    <Color x:Key="TextPrimaryLight">#1B1F24</Color>
    <Color x:Key="TextPrimaryDark">#F1F3F6</Color>
    <Color x:Key="TextSecondaryLight">#5B6472</Color>
    <Color x:Key="TextSecondaryDark">#A6AEBA</Color>
    <Color x:Key="TextMutedLight">#7C8492</Color>
    <Color x:Key="TextMutedDark">#838B97</Color>

    <!-- 选中/强调浅底 -->
    <Color x:Key="PrimarySoftLight">#E9EFFA</Color>
    <Color x:Key="PrimarySoftDark">#232F49</Color>
    <Color x:Key="PrimarySoftStrokeLight">#C7D6F1</Color>
    <Color x:Key="PrimarySoftStrokeDark">#39496A</Color>

    <!-- 警示横幅 -->
    <Color x:Key="WarningBgLight">#FFF4D6</Color>
    <Color x:Key="WarningBgDark">#3A3018</Color>
    <Color x:Key="WarningFgLight">#6B5405</Color>
    <Color x:Key="WarningFgDark">#F0D28A</Color>
    <Color x:Key="WarningStrokeLight">#E6B23A</Color>
    <Color x:Key="WarningStrokeDark">#8A6D1F</Color>

    <Color x:Key="DangerBgLight">#FBE6E8</Color>
    <Color x:Key="DangerBgDark">#3A1E22</Color>
    <Color x:Key="DangerFgLight">#8A1E24</Color>
    <Color x:Key="DangerFgDark">#F4B0B6</Color>
    <Color x:Key="DangerStrokeLight">#E05A62</Color>
    <Color x:Key="DangerStrokeDark">#9E3A42</Color>
    <Color x:Key="DangerLight">#C7363F</Color>
    <Color x:Key="DangerDark">#E36A71</Color>

    <!-- 浮层遮罩 -->
    <Color x:Key="Scrim">#99000000</Color>
</ResourceDictionary>