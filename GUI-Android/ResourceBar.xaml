<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FileEncryptorMobile.ResourceBar"
             xmlns:local="clr-namespace:FileEncryptorMobile">
    <HorizontalStackLayout Spacing="{StaticResource SpacePage}" Padding="4,2">
        <Label x:Name="LblCpu" FontSize="{StaticResource FontSizeCaption}"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" Text="CPU —" />
        <Label x:Name="LblRam" FontSize="{StaticResource FontSizeCaption}"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" Text="{local:Zh 内存 —}" />
    </HorizontalStackLayout>
</ContentView>
