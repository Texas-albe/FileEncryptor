<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ 云备份与换机传输规则：root 域整域排除，即不备份、不迁移任何数据 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
