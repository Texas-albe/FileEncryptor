<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="FileEncryptor GUI (Qt)"
           Manufacturer="FileEncryptor"
           Version="$(var.ProductVersion)"
           UpgradeCode="7F3A1C29-5B64-4E8D-9A0F-2C6B8D1E4A57"
           Language="1033" Codepage="utf-8">

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of FileEncryptor GUI is already installed." />

    <!-- 安装/卸载前关闭运行中的 GUI，避免文件占用 -->
    <util:CloseApplication Id="CloseGui" Target="FileEncryptorGUI-Qt.exe" Description="FileEncryptor GUI is running. Close it to continue." RebootPrompt="no" />
    <!-- FE-Mounter 占用 vdisk.dll / winfsp-x64.dll；不关闭则替换这些文件会因占用失败 -->
    <util:CloseApplication Id="CloseMounter" Target="FE-Mounter.exe" Description="FE-Mounter is running. Close it to continue." RebootPrompt="no" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="app.ico" SourceFile="..\..\GUI-Qt\logogui.ico" />

    <!-- AGPLv3 许可协议 -->
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <Feature Id="MainFeature" Title="FileEncryptor GUI (Qt)" Level="1"
             Description="The main FileEncryptor graphical user interface (Qt). Required.">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="UpdaterExe" />
      <ComponentRef Id="CliExe" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="WerExclusions" />
      <ComponentRef Id="PtdFileAssociation" />
      <!-- 加密盘挂载组件：与 vdisk.dll 捆绑（FE-Mounter 必须 dlopen 它，两者必须同装同卸）。
           CLI 本身不依赖 vdisk.dll，故不选此功能只影响盘符挂载，GUI 会自动隐藏加密盘入口。 -->
      <Feature Id="VaultFeature" Title="Encrypted vault mounting (FE-Mounter)" Level="1"
               Description="Installs FE-Mounter.exe, vdisk.dll and the WinFSP runtime for mounting encrypted vaults as drive letters. The command-line tool works without this; only drive mounting is unavailable.">
        <ComponentRef Id="VdiskDll" />
        <ComponentRef Id="FeMounterExe" />
        <ComponentRef Id="WinFspDll" />
        <ComponentRef Id="WinFspLauncher" />
      </Feature>

      <!-- WinFSP 运行时：把捆绑的 WinFSP 安装包静默装到系统（C:\Program Files (x86)\WinFsp），
           真正注册内核驱动服务，使未预装 WinFSP 的干净机（Win11 22H2/26H2）也能盘符挂载。
           默认勾选；已装则跳过。 -->
      <Feature Id="WinFspFeature" Title="WinFSP runtime (recommended)" Level="1"
               Description="Installs the WinFSP kernel driver and user-mode runtime so encrypted vaults can be mounted as drive letters. Recommended unless WinFSP is already installed system-wide.">
        <ComponentRef Id="WinFspRedist" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch FileEncryptor GUI" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- 检测系统是否已安装 WinFSP（Program Files (x86)\WinFsp\bin\winfsp-x64.dll）。
         已装则跳过捆绑安装，避免重复安装/版本冲突。 -->
    <Property Id="WINFSP_INSTALLED" Secure="yes">
      <DirectorySearch Id="WinFspSearch" Path="[ProgramFilesFolder]WinFsp\bin" Depth="0">
        <FileSearch Id="WinFspDll" Name="winfsp-x64.dll" />
      </DirectorySearch>
    </Property>

    <!-- 自定义操作：静默安装捆绑的 WinFSP（msiexec /i）。安排在 InstallFiles 之后
         （事务内、InstallFinalize 之前，满足 ICE77），此时 redist\winfsp MSI 已落盘。
         用 asyncNoWait + ping 延迟，让 msiexec 在主安装提交、释放 MSI 互斥锁后才真正
         启动，规避「另一安装正在进行」。/norestart 不强制重启。Impersonate=no 以 SYSTEM 提权安装。 -->
    <CustomAction Id="InstallWinFsp"
                  Directory="REDISTDIR"
                  ExeCommand="cmd.exe /c ping -n 6 127.0.0.1 &gt;nul &amp; msiexec.exe /i &quot;[REDISTDIR]winfsp-2.1.25156.msi&quot; /qn /norestart"
                  Execute="deferred"
                  Impersonate="no"
                  Return="asyncNoWait" />

    <!-- 卸载完成后清安装目录残留（与 WinUI 安装器同规格）：RemoveFiles 之后 rd /s /q，
         兜底 MSI 未登记的文件（update_staging、卸载器同目录碎片等）。
         UPGRADINGPRODUCTCODE 时不执行，避免升级过程中误删新装文件；只删 INSTALLFOLDER 本身。 -->
    <CustomAction Id="CleanInstallDir"
                  Directory="INSTALLFOLDER"
                  ExeCommand="cmd.exe /c rd /s /q &quot;[INSTALLFOLDER]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="InstallWinFsp" After="InstallFiles" Condition="&amp;WinFspFeature=3 AND NOT WINFSP_INSTALLED" />
      <Custom Action="CleanInstallDir" After="RemoveFiles" Condition="NOT UPGRADINGPRODUCTCODE AND REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FileEncryptor (Qt)">
        <Directory Id="REDISTDIR" Name="redist" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="FileEncryptor (Qt)" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <!-- 主程序 exe（独立组件以便引用快捷方式） -->
    <Component Id="MainExe" Directory="INSTALLFOLDER">
      <File Id="MainExeFile" Source="$(var.PublishDir)FileEncryptorGUI-Qt.exe" KeyPath="yes" />
    </Component>

    <!-- 自动更新辅助程序：GUI 用它检查并应用更新 -->
    <Component Id="UpdaterExe" Directory="INSTALLFOLDER">
      <File Id="UpdaterExeFile" Source="$(var.PublishDir)Updater.exe" KeyPath="yes" />
    </Component>

    <!-- CLI 命令行工具：GUI 通过 features 探测其能力，故为必选 -->
    <Component Id="CliExe" Directory="INSTALLFOLDER">
      <File Id="CliExeFile" Source="$(var.PublishDir)FileEncryptorCLI.exe" KeyPath="yes" />
    </Component>
    <!-- 加密盘虚拟磁盘共享库（libvdisk 实现）。属可选功能 VaultFeature：CLI 不依赖它，
         但 FE-Mounter 必须 dlopen，故与 FeMounterExe 同装同卸。 -->
    <Component Id="VdiskDll" Directory="INSTALLFOLDER">
      <File Id="VdiskDllFile" Source="$(var.PublishDir)vdisk.dll" KeyPath="yes" />
    </Component>
    <!-- FE-Mounter holder 进程：挂载/可写挂载 Windows 盘符。属可选功能 VaultFeature -->
    <Component Id="FeMounterExe" Directory="INSTALLFOLDER">
      <File Id="FeMounterExeFile" Source="$(var.PublishDir)FE-Mounter.exe" KeyPath="yes" />
    </Component>

    <!-- WinFSP 用户态运行时。FE-Mounter 静态导入 winfsp-x64.dll：缺它进程加载即失败，
         盘符挂载整个用不了（且没有任何报错）。launcher 是 WinFSP 服务启动器，
         目标机未预装 WinFSP 时由 winfsp-x64.dll 拉起它。二者必须与 FE-Mounter.exe 同目录。
         拆成两个单文件组件：多文件组件用自动 GUID(*) 要求非 keypath 文件不带版本，
         而 dll/exe 都带版本，会触发 WIX0368，故各自独立组件。 -->
    <Component Id="WinFspDll" Directory="INSTALLFOLDER">
      <File Id="WinFspDllFile" Source="$(var.PublishDir)winfsp-x64.dll" KeyPath="yes" />
    </Component>

    <Component Id="WinFspLauncher" Directory="INSTALLFOLDER">
      <File Id="WinFspLauncherFile" Source="$(var.PublishDir)launcher-x64.exe" KeyPath="yes" />
    </Component>

    <!-- WinFSP 安装包（捆绑进 MSI，落入 INSTALLFOLDER\redist）。由 WinFspFeature 控制安装，
         安装阶段由 InstallWinFsp 自定义操作静默装到系统。 -->
    <Component Id="WinFspRedist" Directory="REDISTDIR">
      <File Id="WinFspMsi" Source="..\..\Third Party\winfsp-2.1.25156.msi" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuDir">
      <Shortcut Id="StartMenuSc"
                Name="FileEncryptor GUI"
                Target="[#MainExeFile]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="app.ico" />
      <!-- 开始菜单「卸载」入口：直接调 Windows Installer 卸载本产品，不再随包附带卸载器。 -->
      <Shortcut Id="UninstallSc"
                Name="卸载 FileEncryptor"
                Target="[SystemFolder]msiexec.exe"
                Arguments="/x [ProductCode]"
                Icon="app.ico" />
      <RemoveFolder Id="RemoveProgramMenu" Directory="ProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\FileEncryptor\GUI"
                     Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="DesktopSc"
                Name="FileEncryptor GUI (Qt)"
                Target="[#MainExeFile]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="app.ico" />
      <RegistryValue Root="HKCU" Key="Software\FileEncryptor\GUI"
                     Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- P1-3 禁崩溃转储（整机，与 WinUI 安装器同规格）：在 HKLM\SOFTWARE\Microsoft\Windows\
         Windows Error Reporting\ExcludedApplications 下写 <exe>=1（DWORD），格式与
         WerAddExcludedApplication(bAllUsers=TRUE) 一致（WinUI 侧已实证）。
         运行时 OsHarden::disableCrashDump 只登记 GUI 自身 exe，覆盖不到真正持口令/KEK 的
         子进程（FileEncryptorCLI / FE-Mounter）与 Updater/RestartAgent，故由安装器补齐。 -->
    <Component Id="WerExclusions" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\ExcludedApplications"
                     Name="FileEncryptorGUI-Qt.exe" Type="integer" Value="1" KeyPath="yes" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\ExcludedApplications"
                     Name="FE-Mounter.exe" Type="integer" Value="1" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\ExcludedApplications"
                     Name="FileEncryptorCLI.exe" Type="integer" Value="1" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\ExcludedApplications"
                     Name="Updater.exe" Type="integer" Value="1" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\ExcludedApplications"
                     Name="RestartAgent.exe" Type="integer" Value="1" />
    </Component>

    <!-- .ptd 文件关联 -->
    <Component Id="PtdFileAssociation" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCR" Key=".ptd"
                     Value="FileEncryptor.Qt.ptd" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKCR" Key="FileEncryptor.Qt.ptd"
                     Value="FileEncryptor Encrypted File (Qt)" Type="string" />
      <RegistryValue Root="HKCR" Key="FileEncryptor.Qt.ptd\DefaultIcon"
                     Value="&quot;[#MainExeFile]&quot;,0" Type="string" />
      <RegistryValue Root="HKCR" Key="FileEncryptor.Qt.ptd\shell\open\command"
                     Value="&quot;[#MainExeFile]&quot; &quot;%1&quot;" Type="string" />
    </Component>
  </Fragment>

</Wix>
