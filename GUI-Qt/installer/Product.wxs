<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="FileEncryptor GUI (Qt)"
           Manufacturer="FileEncryptor"
           Version="$(var.ProductVersion)"
           UpgradeCode="7F3A1C29-5B64-4E8D-9A0F-2C6B8D1E4A57"
           Language="1033" Codepage="utf-8">

    <MajorUpgrade DowngradeErrorMessage="A newer version of FileEncryptor GUI is already installed." />

    <!-- Close running GUI before install/uninstall to avoid file-in-use errors -->
    <util:CloseApplication Id="CloseGui" Target="FileEncryptorGUI-Qt.exe" Description="FileEncryptor GUI is running. Close it to continue." RebootPrompt="no" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="app.ico" SourceFile="..\..\GUI-Qt\logogui.ico" />

    <!-- GPLv3 License -->
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <Feature Id="MainFeature" Title="FileEncryptor GUI (Qt)" Level="1"
             Description="The main FileEncryptor graphical user interface (Qt). Required.">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="UpdaterExe" />
      <ComponentRef Id="CliExe" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <!-- 加密盘挂载组件：与 vdisk.dll 捆绑（FE-Mounter 必须 dlopen 它，两者必须同装同卸）。
           CLI 本身不依赖 vdisk.dll，故不选此功能只影响盘符挂载，GUI 会自动隐藏加密盘入口。 -->
      <Feature Id="VaultFeature" Title="Encrypted vault mounting (FE-Mounter)" Level="1"
               Description="Installs FE-Mounter.exe, vdisk.dll and the WinFSP runtime for mounting encrypted vaults as drive letters. The command-line tool works without this; only drive mounting is unavailable.">
        <ComponentRef Id="VdiskDll" />
        <ComponentRef Id="FeMounterExe" />
        <ComponentRef Id="WinFspDll" />
        <ComponentRef Id="WinFspLauncher" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch FileEncryptor GUI" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FileEncryptor (Qt)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="FileEncryptor (Qt)" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <!-- Main exe (separate component for shortcut reference) -->
    <Component Id="MainExe" Directory="INSTALLFOLDER">
      <File Id="MainExeFile" Source="$(var.PublishDir)FileEncryptorGUI-Qt.exe" KeyPath="yes" />
    </Component>

    <!-- Auto-update helper: needed by the GUI to check and apply updates -->
    <Component Id="UpdaterExe" Directory="INSTALLFOLDER">
      <File Id="UpdaterExeFile" Source="$(var.PublishDir)Updater.exe" KeyPath="yes" />
    </Component>

    <!-- CLI 命令行工具：GUI 通过 features 探测其能力，故为必选 -->
    <Component Id="CliExe" Directory="INSTALLFOLDER">
      <File Id="CliExeFile" Source="$(var.PublishDir)FileEncryptorCLI.exe" KeyPath="yes" />
    </Component>
    <!-- 加密盘虚拟磁盘共享库（libvdisk 实现）。属可选功能 VaultFeature：CLI 不依赖它，
         但 FE-Mounter 必须 dlopen，故与 FeMounterExe 同装同卸。 -->
    <Component Id="VdiskDll" Directory="INSTALLFOLDER">
      <File Id="VdiskDllFile" Source="$(var.PublishDir)vdisk.dll" KeyPath="yes" />
    </Component>
    <!-- FE-Mounter holder 进程：挂载/可写挂载 Windows 盘符。属可选功能 VaultFeature -->
    <Component Id="FeMounterExe" Directory="INSTALLFOLDER">
      <File Id="FeMounterExeFile" Source="$(var.PublishDir)FE-Mounter.exe" KeyPath="yes" />
    </Component>

    <!-- WinFSP 用户态运行时。FE-Mounter 静态导入 winfsp-x64.dll：缺它进程加载即失败，
         盘符挂载整个用不了（且没有任何报错）。launcher 是 WinFSP 服务启动器，
         目标机未预装 WinFSP 时由 winfsp-x64.dll 拉起它。二者必须与 FE-Mounter.exe 同目录。
         拆成两个单文件组件：多文件组件用自动 GUID(*) 要求非 keypath 文件不带版本，
         而 dll/exe 都带版本，会触发 WIX0368，故各自独立组件。 -->
    <Component Id="WinFspDll" Directory="INSTALLFOLDER">
      <File Id="WinFspDllFile" Source="$(var.PublishDir)winfsp-x64.dll" KeyPath="yes" />
    </Component>

    <Component Id="WinFspLauncher" Directory="INSTALLFOLDER">
      <File Id="WinFspLauncherFile" Source="$(var.PublishDir)launcher-x64.exe" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuDir">
      <Shortcut Id="StartMenuSc"
                Name="FileEncryptor GUI"
                Target="[#MainExeFile]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="app.ico" />
      <RemoveFolder Id="RemoveProgramMenu" Directory="ProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\FileEncryptor\GUI"
                     Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="DesktopSc"
                Name="FileEncryptor GUI (Qt)"
                Target="[#MainExeFile]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="app.ico" />
      <RegistryValue Root="HKCU" Key="Software\FileEncryptor\GUI"
                     Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
